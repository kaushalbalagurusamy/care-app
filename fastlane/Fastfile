require "shellwords"
require "fileutils"
require "plist"

opt_out_usage
default_platform(:ios)

platform :ios do
  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )
  end

  desc "Verify the API key against App Store Connect without changing anything"
  lane :verify_api do
    connect_api_key
    apps = Spaceship::ConnectAPI::App.all
    UI.success("App Store Connect API authentication succeeded")

    bundle_id = ENV.fetch("APP_IDENTIFIER")
    app = apps.find { |candidate| candidate.bundle_id == bundle_id }
    if app
      UI.success("Found App Store Connect app: #{app.name} (#{bundle_id})")
    else
      UI.important("No App Store Connect app record found for #{bundle_id}; create one before the first upload")
    end

    begin
      identifier = Spaceship::ConnectAPI::BundleId.find(bundle_id)
      if identifier
        UI.success("Registered bundle ID found: #{identifier.identifier}")
        UI.message("Developer Team ID: #{identifier.seed_id}") if identifier.seed_id
        if identifier.seed_id && identifier.seed_id != ENV.fetch("APPLE_TEAM_ID")
          UI.user_error!("The registered bundle ID belongs to a different Developer Team")
        end
      else
        UI.important("Bundle ID #{bundle_id} is not registered with this Developer Team")
      end
    rescue => error
      UI.important("Could not read the registered App ID: #{error.message}")
    end
  end

  desc "Increment the TestFlight build number, archive, and upload to TestFlight"
  lane :beta do
    api_key = connect_api_key
    bundle_id = ENV.fetch("APP_IDENTIFIER")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    project = File.expand_path("../ios/CAREApp.xcodeproj", __dir__)
    secrets_dir = File.expand_path("secrets", __dir__)

    cert(
      api_key: api_key,
      development: false,
      output_path: secrets_dir,
      team_id: team_id
    )
    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      development: false,
      output_path: secrets_dir,
      team_id: team_id
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    version = get_version_number(xcodeproj: project, target: "CAREApp")
    remote_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      version: version,
      initial_build_number: 0
    )
    local_build = get_build_number(xcodeproj: project)
    next_build = [remote_build.to_i, local_build.to_i].max + 1
    increment_build_number(
      xcodeproj: project,
      build_number: next_build
    )

    xcode_auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_path)}",
      "-authenticationKeyID #{Shellwords.escape(ENV.fetch('ASC_KEY_ID'))}",
      "-authenticationKeyIssuerID #{Shellwords.escape(ENV.fetch('ASC_ISSUER_ID'))}"
    ].join(" ")

    output_dir = File.expand_path("../build/fastlane", __dir__)
    archive_path = File.join(output_dir, "CAREApp-#{version}-#{next_build}.xcarchive")
    export_dir = File.join(output_dir, "export-#{version}-#{next_build}")
    export_options_path = File.join(output_dir, "ExportOptions-#{version}-#{next_build}.plist")
    FileUtils.mkdir_p(output_dir)

    build_app(
      project: project,
      scheme: "CAREApp",
      configuration: "Release",
      archive_path: archive_path,
      skip_package_ipa: true,
      xcargs: "#{xcode_auth} DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=#{Shellwords.escape('Apple Distribution')} PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
    )

    File.write(export_options_path, Plist::Emit.dump({
      "method" => "app-store-connect",
      "signingStyle" => "manual",
      "teamID" => team_id,
      "provisioningProfiles" => { bundle_id => profile_name }
    }))
    FileUtils.mkdir_p(export_dir)
    sh(Shellwords.join([
      "xcodebuild", "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", export_dir,
      "-exportOptionsPlist", export_options_path,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    ]))
    ipa_path = Dir[File.join(export_dir, "*.ipa")].first
    UI.user_error!("Xcode export did not produce an IPA") unless ipa_path

    if ENV["SKIP_TESTFLIGHT_UPLOAD"] == "1"
      UI.success("Release IPA prepared for review without uploading: #{ipa_path}")
      next ipa_path
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload an already exported IPA to TestFlight"
  lane :upload_ipa do
    api_key = connect_api_key
    ipa_path = File.expand_path(ENV.fetch("IPA_PATH"))
    UI.user_error!("IPA not found: #{ipa_path}") unless File.file?(ipa_path)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
