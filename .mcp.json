{
  "mcpServers": {
    "XcodeBuildMCP": {
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest", "mcp"]
    },
    "swift-mcp": {
      "command": "npx",
      "args": ["-y", "swift-mcp"]
    },
    "DesktopCommander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander@latest", "setup"]
    }
  }
}
